# Postgres (shared instance, schema-per-system)
POSTGRES_USER=vz_poc
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=vz_poc
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Gateway
GATEWAY_API_KEY=dev-gateway-key-change-me
GATEWAY_RATE_LIMIT_PER_MIN=60

# Bedrock (AWS credentials picked up from the environment / default profile)
AWS_REGION=eu-west-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Langfuse Cloud (EU region)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Governance policy
GOVERNANCE_AUTO_APPROVE_DELTA_EUR=15.00
